# --- Database ---
# Default: local SQLite file, zero setup. For prod, point at Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/timesheet_ai
DATABASE_URL=sqlite:///./timesheet_ai.db

# --- Workfront ---
# To run against REAL data, set WORKFRONT_MODE=real and fill the two below.
WORKFRONT_MODE=mock          # mock | real
WORKFRONT_BASE_URL=https://dizitechptrsd.my.workfront.com/attask/api/v21.0
WORKFRONT_API_KEY=           # your OAuth access token (goes in Authorization: Bearer <token>)

# --- LLM (narrative step only — never used for numbers) ---
MOCK_LLM=true                # true = no external calls, deterministic templated narrative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Business rules ---
DEFAULT_EXPECTED_HOURS=40
NON_STANDARD_UTIL_THRESHOLD=0.3
RECOMMENDATION_STALENESS_MINUTES=30

# --- Real-time (optional; app works without Redis, just no live push) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
LOG_LEVEL=INFO

# --- Sync script options ---
SYNC_LIMIT=100               # how many timesheet headers to pull
SYNC_ONLY_WITH_HOURS=1       # 1 = skip timesheets with totalHours==0
